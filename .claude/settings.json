{
  "permissions": {
    "allow": [
      "Bash(node scripts/download-player-pgn.js *)",
      "Bash(python3 -c *)",
      "Bash(python3 scripts/ingest_pgn.py *)",
      "Bash(pip3 install -r scripts/requirements.txt)",
      "Bash(curl -L * -o pgn/*.pgn)",
      "WebFetch(domain:www.pgnmentor.com)",
      "WebFetch(domain:lichess.org)",
      "Read(//private/tmp/**)",
      "Bash(grep -r \"body\\\\|html\\\\|#root\" /Users/guillermoperez/Projects/playground/aperturas-de-ajedrez/src/*.css)",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_close",
      "Bash(pkill -f \"npm run dev\")",
      "WebFetch(domain:en.wikibooks.org)",
      "WebFetch(domain:es.wikipedia.org)",
      "Bash(grep -E \"\\\\.\\(js|ts\\)$\")",
      "Bash(npx playwright *)",
      "Bash(npx lighthouse *)",
      "Bash(npm start *)",
      "Bash(npm audit *)",
      "Bash(node -e ' *)",
      "Bash(node)",
      "Read(//Users/guillermoperez/.claude/**)",
      "Bash(docker compose *)",
      "Bash(docker info *)",
      "Bash(npm run json-to-database)",
      "Bash(stockfish --version)",
      "Bash(find /usr/local /opt/homebrew /usr /Applications -name \"stockfish\" -type f 2>/dev/null | head -10)",
      "Read(//usr/local/**)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/guillermoperez/Projects/playground/aperturas-de-ajedrez/.playwright-mcp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE '^git commit'; then if ! npm run lint 2>&1; then printf '{\"continue\":false,\"stopReason\":\"npm run lint falló — corrige los errores antes de hacer commit.\"}'; exit 1; fi; fi",
            "statusMessage": "Verificando lint antes de commit..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/audit-openings.js --hook"
          },
          {
            "type": "command",
            "command": "node -e \"const d=JSON.parse(require('fs').readFileSync(0,'utf8'));const fp=(d.tool_input||{}).file_path||'';if(/src\\/data\\/openings\\/.*\\.js$/.test(fp)){console.log('openings.js fue modificado \\u2192 DEBES ejecutar el skill sync-opening-routes ahora: actualiza routes.js, PANEL_OPENINGS (si es apertura nueva) y la lista de aperturas en README.md. El sitemap se regenera automaticamente en el build.');process.exit(2);}\""
          }
        ]
      }
    ]
  }
}
