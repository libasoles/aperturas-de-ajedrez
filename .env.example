NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_HAS_PREMIUM_ACCESS=0
NEXT_PUBLIC_STOCKFISH_LABEL_THRESHOLD=0.5

# Neo4j AuraDB — required for Netlify Functions (/api/*)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# Neo4j Community Edition local — opening tree analysis (docker/neo4j-openings/docker-compose.yml)
NEO4J_OPENINGS_URI=bolt://localhost:7687
NEO4J_OPENINGS_USERNAME=neo4j
NEO4J_OPENINGS_PASSWORD=openings-password
NEO4J_OPENINGS_DATABASE=neo4j
